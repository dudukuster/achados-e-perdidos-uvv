// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma_v2"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  ELETRONICOS
  DOCUMENTOS
  ACESSORIOS
  MATERIAIS_ESCOLARES
  OUTROS
}

enum Location {
  BIBLIOTECA
  LABORATORIOS
  CANTINA
  SALAS_DE_AULA
  AREAS_COMUNS
}

enum Status {
  PERDIDO
  ENCONTRADO
}

model User {
  id          String               @id @default(uuid())
  name        String
  email       String               @unique
  password    String
  items       Item[]
  comments    Comment[]
  resetTokens PasswordResetToken[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Item {
  id          String      @id @default(uuid())
  title       String
  description String
  category    Category
  location    Location
  lostDate    DateTime
  status      Status      @default(PERDIDO)
  user        User        @relation(fields: [userId], references: [id])
  userId      String
  comments    Comment[]
  images      ItemImage[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([category])
  @@index([location])
  @@index([status])
  @@index([userId])
}

model ItemImage {
  id        String   @id @default(uuid())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  url       String
  position  Int
  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([position])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([authorId])
}

model PasswordResetToken {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

